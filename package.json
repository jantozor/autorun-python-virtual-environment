{
  "name": "autorun-python-virtual-environment",
  "displayName": "Autorun-python-virtual-environment",
  "description": "This extensions only create an empty python environment and the corresponding settings to activate this environment each time the project folder is opened.",
  "version": "1.0.0",
  "engines": {
    "vscode": "^1.99.0"
  },
  "categories": [
    "Programming Languages","Snippets","Linters"
  ],
  "activationEvents": ["onLanguage:python"],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "autorun-python-virtual-environment.Python_Virtual_Enviroment",
        "title": "Python Virtual Enviroment"
      }
    ],
    "configuration":{
      "title": "Autorun Python Virtual Environment Settings",
      "type": "object",
      "properties": {
        "autorun-python-virtual-environment.runOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Run virtual environment logic when saving a Python file."
        },
        "autorun-python-virtual-environment.venv": {
          "type": "string",
          "default": "env",
          "description": "Relative path where the virtual environment will be created."
        }
      }

    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.99.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@typescript-eslint/eslint-plugin": "^8.28.0",
    "@typescript-eslint/parser": "^8.28.0",
    "eslint": "^9.23.0",
    "typescript": "^5.8.2",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1"
  }
}
